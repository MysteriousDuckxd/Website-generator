# --- Server ---
PORT=3000
# Public HTTPS URL where this server is reachable (e.g. from ngrok or your host).
# Needed for: hosting preview sites for prospects, automated-message calls, call status updates.
PUBLIC_URL=

# --- Your info (used in call scripts and footer of generated sites) ---
AGENCY_NAME=Main Street Web Studio
YOUR_NAME=
# Your own phone. "Bridge" calls ring you first, then connect you to the business.
OWNER_PHONE=

# --- Twilio (https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set to 1 to simulate calls without dialing anyone (default when Twilio isn't configured)
DRY_RUN=1

# --- Calling rules ---
DEFAULT_COUNTRY_CODE=1
DEFAULT_TIMEZONE=America/New_York
# Local time of the BUSINESS being called. Days: 0=Sun ... 6=Sat
CALL_HOURS_START=9
CALL_HOURS_END=17
CALL_DAYS=1,2,3,4,5
MAX_ATTEMPTS_PER_BUSINESS=3
MIN_HOURS_BETWEEN_ATTEMPTS=24
